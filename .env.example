# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google Cloud → Credentials → cliente OAuth "Web application" (el mismo que usa Supabase).
# Lo usa el login nativo de la app Android.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
